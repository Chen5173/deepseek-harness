# Docker build context filters for the my-custom Docker deployment.
# Excludes VCS metadata, dependencies, build outputs, and local state so
# `docker build` sends only what the image actually needs.
# NOTE: my-custom/Dockerfile + docker-entrypoint.sh + docker-compose.yml are
# REQUIRED by the build and must NOT be excluded here.

# VCS
.git
.gitattributes
.gitignore
.github
.gitlab-ci.yml

# Dependencies & package manager state
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store
.pnpm-workspace-state.json
pnpm-debug.log

# Build outputs (regenerated inside the image)
lib
**/lib
dist
**/dist
**/*.tsbuildinfo
.dsh-build
coverage
dist-exe
tmp
.humanize

# Locally generated client bundle dirs (no sources / package.json; produced by
# the local tsc+tsdown build). If shipped even as empty dirs, tsdown's
# `packages/*/*` workspace glob matches them and fails on the missing lib/types
# entry (@deepseek-ai/dsh-root Cannot find entry).
packages/client/web-react
packages/client/schema-form

# Local harness state
.storages
.sessions
examples/*/.sessions
examples/*/*.jsonl

# Doc/tool caches
docs/.vitepress/cache
website/.vitepress/cache
node_modules/.cache
node_modules/.vite
.vscode
.idea
.DS_Store

# my-custom runtime secrets & data (generated by start.sh, never baked in)
my-custom/.dsh-auth
my-custom/.dsh-tunnel-url
my-custom/.env
my-custom/dsh-data
my-custom/start.sh
my-custom/stop.sh
my-custom/start-docker.bat
my-custom/stop-docker.bat
my-custom/README.md

# Baked-in web-profile seed + vendored local plugins: these MUST ship in the
# build context even though they contain dirs the generic rules above exclude
# (e.g. vendor-plugins/dsh-billing-balance/lib). Negations must come after the
# broad patterns they re-include.
!my-custom/plugins-web
!my-custom/vendor-plugins/**
