{
  "name": "dsh-oh-my-dsh-config",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Oh-My-Dsh 个人定制提取件：会话标题提供器配置 + 浏览器品牌（标签页标题 + 侧栏品牌块），零内核改动",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
